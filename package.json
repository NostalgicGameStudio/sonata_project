{
  "name": "sonata-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Sonata - Multi-platform YouTube audio converter and timestamp-based slicer",
  "workspaces": [
    "apps/desktop",
    "apps/web",
    "packages/shared-types",
    "packages/ui"
  ],
  "scripts": {
    "dev:desktop": "npm run dev --workspace=apps/desktop",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "apps\\api\\venv\\Scripts\\python apps/api/manage.py runserver",
    "build:desktop": "npm run build:win --workspace=apps/desktop",
    "test": "echo \"Suíte de testes\"",
    "test:api": "apps\\api\\venv\\Scripts\\python apps/api/manage.py test core",
    "build": "npm run build --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "husky": "^9.1.7"
  }
}
