{
  "name": "sonata-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Sonata - Multi-platform YouTube audio converter and timestamp-based slicer",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm run dev --workspace=apps/desktop",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "powershell -Command \"& apps/api/venv/Scripts/Activate.ps1; python apps/api/manage.py runserver\"",
    "test": "echo \"Suíte de testes\"",
    "test:api": "powershell -Command \"& apps/api/venv/Scripts/Activate.ps1; python apps/api/manage.py test core\"",
    "build": "npm run build --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "husky": "^9.1.7"
  }
}
